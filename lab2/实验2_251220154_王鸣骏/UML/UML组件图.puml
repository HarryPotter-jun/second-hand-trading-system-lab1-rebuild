@startuml UML组件图
' ================= 统一样式 =================
skinparam defaultFontName "Microsoft YaHei"
skinparam dpi 150
skinparam shadowing false
skinparam componentStyle rectangle
skinparam packageStyle rectangle
skinparam packageBackgroundColor #F8FAFC
skinparam packageBorderColor #7A8CA0
skinparam ArrowColor #333333
skinparam nodeBackgroundColor #FFFFFF
!pragma layout smetana

title 二手交易系统 组件图（三层架构 + 公共支撑组件）

actor "买家 / 卖家 / 管理员\n(浏览器 / 手机浏览器)" as 用户

' ================= 客户端层 =================
package "客户端层（响应式 Web 页面，视口 ≥ 360px）" #E9F2FB {
  [登录注册页面] as P1
  [商品浏览与查询页面] as P2
  [商品详情页面\n(预约/收藏/举报入口)] as P3
  [商品发布与编辑页面] as P4
  [个人中心页面\n(我的商品/我的预约/收藏)] as P5
  [管理员工作台页面\n(审核/举报/日志/统计)] as P6
}

' ================= 业务服务层 =================
package "业务服务层" #EDF7ED {
  [认证与权限模块] as M1
  [商品模块] as M2
  [预约与交易模块] as M3
  [收藏模块] as M4
  [举报模块] as M5
  [审核与管理模块] as M6
}

' ================= 公共支撑 =================
package "公共支撑组件（横切关注）" #FDF0E7 {
  [操作日志组件 «拦截器»] as S1
  [版本并发控制组件 «乐观锁»] as S2
  [参数校验组件] as S3
}

' ================= 数据访问层 =================
package "数据访问层（Repository 仓储）" #F3EDFB {
  [用户仓储] as D1
  [商品与交易仓储\n(商品/预约/交易确认)] as D2
  [收藏与举报仓储] as D3
  [日志仓储] as D4
}

database "关系数据库\n（用户 / 商品 / 预约 / 交易确认 /\n收藏 / 举报 / 操作日志）" as DB

' ================= 关系：客户端 → 业务层 =================
用户 --> P1
用户 --> P2
用户 --> P4
用户 --> P5
用户 --> P6

P1 --> M1
P2 --> M2
P3 --> M2
P3 --> M3
P3 --> M4
P3 --> M5
P4 --> M2
P5 --> M2
P5 --> M3
P5 --> M4
P6 --> M6

' ================= 关系：业务层 → 支撑/数据层 =================
M1 --> D1
M2 --> D2
M3 --> D2
M4 --> D3
M5 --> D3
M6 --> D2
M6 --> D3
M6 --> D4

M3 ..> S2 : 预约/取消/确认\n校验商品版本
S2 ..> D2 : 原子条件更新\n(CHECK 状态 + 版本号)

M1 ..> S1
M2 ..> S1
M3 ..> S1
M6 ..> S1
S1 --> D4

M1 ..> S3
M2 ..> S3
M3 ..> S3

D1 --> DB
D2 --> DB
D3 --> DB
D4 --> DB

note bottom of S2
  <b>版本并发控制(REQ-012)</b>
  商品状态变化与关键字段修改后版本号 +1；
  预约、取消、交易确认请求必须携带期望版本号，
  不匹配则拒绝写入并提示刷新。
end note

note right of M3
  <b>事务与原子性(REQ-019)</b>
  预约与交易模块的每个关键写入在同一数据库
  事务内完成：商品状态、预约记录、交易确认、
  日志任一失败则整体回滚，不产生部分更新。
end note
@enduml
