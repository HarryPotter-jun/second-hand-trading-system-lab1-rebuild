@startuml UML类图
' ================= 统一样式 =================
skinparam defaultFontName "Microsoft YaHei"
skinparam dpi 150
skinparam shadowing false
skinparam classAttributeIconSize 0
skinparam packageStyle rectangle
skinparam packageBackgroundColor #F8FAFC
skinparam packageBorderColor #7A8CA0
skinparam ArrowColor #333333
skinparam classBackgroundColor #FFFFFF
skinparam classBorderColor #4A5A6A
skinparam noteBackgroundColor #FFF8DC
!pragma layout smetana

title 二手交易系统 类图（实体层 + 应用服务层）

' ================= 实体层 =================
package "实体层（领域模型）" #E9F2FB {
  abstract class 用户 {
    # 用户Id : long
    # 手机号 : String «唯一»
    # 用户名 : String «可修改，不唯一»
    # 密码摘要 : String «不可逆保存»
    + 修改用户名(新用户名)
    + {abstract} 允许的操作() : Set<操作>
  }
  class 买家 {
    + 预约商品(商品, 版本号)
    + 取消本人预约(预约)
    + 确认收货(预约)
    + 收藏商品(商品)
    + 举报商品(商品, 原因)
  }
  class 卖家 {
    + 创建/编辑草稿(商品)
    + 提交审核(商品)
    + 下架在售商品(商品)
    + 确认或拒绝预约(预约)
    + 确认交付(预约)
  }
  class 管理员 {
    + 审核商品(商品, 结论, 原因)
    + 违规下架(商品, 原因)
    + 处理举报(举报, 结论)
    + 查询日志(条件)
    + 查看统计(维度)
  }

  class 商品 {
    + 商品Id : long
    + 标题 / 描述 : String
    + 分类 / 成色 : String
    + 价格 : BigDecimal «(0, 1000000]»
    + 图片列表 : List<String>
    + 取货方式 : {自取, 邮寄}
    + 状态 : 商品状态
    + 版本号 : int «乐观锁»
    + 发布时间 : DateTime
    + 提交审核()
    + 变更状态(目标状态) «仅允许转换表»
    + 是否终态() : boolean
  }
  enum 商品状态 {
    草稿
    待审核
    在售
    已预约
    已售出 «终态»
    已下架 «终态»
    违规下架 «终态»
  }

  class 预约 {
    + 预约Id : long
    + 买家Id : long
    + 商品Id : long
    + 状态 : 预约状态
    + 创建时间 : DateTime
    + 买家取消()
    + 卖家确认()
    + 卖家拒绝()
    + 完成交易()
  }
  enum 预约状态 {
    待确认 «有效»
    已确认 «有效»
    已取消 «终态»
    已拒绝 «终态»
    已完成 «终态»
  }
  class 交易确认 {
    + 确认Id : long
    + 预约Id : long
    + 卖家确认交付时间 : DateTime
    + 买家确认收货时间 : DateTime
    + 卖家确认交付()
    + 买家确认收货()
    + 双方均已确认() : boolean
  }

  class 收藏 {
    + 收藏Id : long
    + 买家Id : long
    + 商品Id : long
    + 创建时间 : DateTime
  }
  class 举报 {
    + 举报Id : long
    + 举报人Id : long
    + 商品Id : long
    + 举报原因 : String
    + 状态 : {待处理, 已驳回, 违规确认}
    + 处理人 / 处理时间 / 处理结果
  }
  class 操作日志 {
    + 日志Id : long
    + 操作者Id : long
    + 操作类型 : String
    + 对象类型 / 对象Id : long
    + 操作结果 : {成功, 失败}
    + 原因 : String
    + 操作时间 : DateTime
  }
}

' ================= 应用服务层 =================
package "应用服务层（用例编排）" #EDF7ED {
  class 认证服务 {
    + 注册(手机号, 密码, 角色)
    + 登录(手机号, 密码) : 令牌
    + 校验权限(用户, 操作) : boolean
    + 拦截未登录访问()
  }
  class 商品服务 {
    + 创建草稿(卖家, 信息)
    + 更新商品(商品, 新信息)
    + 提交审核(商品Id)
    + 组合查询(关键词, 分类, 价格区间,\n状态, 时间) : List<商品>
    + 查看详情(商品Id, 访问者) «可见性过滤»
    + 下架(商品Id, 卖家)
    + 校验金额与重复提交()
  }
  class 预约服务 {
    + 发起预约(商品Id, 买家, 期望版本号) «首个成功为准»
    + 取消预约(预约Id, 操作者)
    + 卖家处理(预约Id, 结论)
    + 校验状态与版本() «乐观锁»
  }
  class 交易服务 {
    + 确认交付(预约Id, 卖家)
    + 确认收货(预约Id, 买家)
    + 原子完成交易() «商品+预约同步»
  }
  class 收藏服务 {
    + 收藏(商品Id, 买家) «同一商品唯一»
    + 取消收藏(商品Id, 买家)
    + 我的收藏列表(买家)
  }
  class 举报服务 {
    + 提交举报(商品Id, 举报人, 原因)
    + 处理举报(举报Id, 管理员, 结论)
  }
  class 日志服务 {
    + 记录(操作者, 对象, 类型, 结果, 原因)
    + 查询(操作者, 对象, 类型, 时间段)
  }
  class 统计服务 {
    + 按状态统计() : Map<状态, 数量>
    + 按分类统计() : Map<分类, 数量>
  }
}

' ================= 实体间关联 =================
买家 --|> 用户
卖家 --|> 用户
管理员 --|> 用户

卖家 "1" --> "0..*" 商品 : 发布 / 拥有 >
商品 "1" *--> "1" 商品状态
买家 "1" --> "0..*" 预约 : 发起 >
商品 "1" --> "0..*" 预约 : 被预约 «保留历史»
预约 "1" *--> "1" 预约状态
预约 "1" --> "0..1" 交易确认 : 对应 >
买家 "1" --> "0..*" 收藏 : 收藏 >
商品 "1" --> "0..*" 收藏 : 被收藏
用户 "1" --> "0..*" 举报 : 提交 >
商品 "1" --> "0..*" 举报 : 被举报
用户 "1" --> "0..*" 操作日志 : 执行 >

note bottom of 商品
  <b>数据一致性约束(REQ-013)</b>
  同一商品任一时刻至多一条有效预约
  (状态∈{待确认, 已确认})；
  同一买家对同一商品至多一条收藏、
  至多一条待处理举报。
end note

' ================= 服务与实体的依赖 =================
认证服务 ..> 用户 : 注册 / 校验
商品服务 --> 商品 : 管理 / 查询
预约服务 --> 预约 : 编排
预约服务 ..> 商品 : 校验状态与版本
交易服务 --> 交易确认 : 双方确认
收藏服务 --> 收藏 : 编排
举报服务 --> 举报 : 编排
日志服务 --> 操作日志 : 读写
统计服务 ..> 商品 : 汇总查询

note bottom of 日志服务
  <b>横切关注(REQ-014)</b>
  认证、商品、预约、交易、举报等所有
  业务服务在关键操作前后均调用日志服务
  记录操作者、对象、结果与原因
  （为保持图面清晰，其余连线省略）。
end note
@enduml
